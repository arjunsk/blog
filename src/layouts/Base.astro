---
import '../styles/global.css';
import { sitePath } from '../site';

interface Props {
  title: string;
  description: string;
  section?: 'blog';
}

const { title, description, section } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#111214" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={sitePath('favicon.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#content" class="skip">Skip to content</a>
    <header class="shell site-header">
      <a class="brand" href={sitePath()} aria-label="Arjun, home">Arjun</a>
      <nav aria-label="Main navigation">
        <a href={sitePath('#projects')}>Projects</a>
        <a href={sitePath('posts/')} aria-current={section === 'blog' ? 'page' : undefined}>Blog</a>
        <a href="https://github.com/arjunsk">GitHub</a>
      </nav>
    </header>
    <main id="content" class="shell">
      <slot />
    </main>
  </body>
</html>
