---
import '../styles/global.css';
import { siteName, sitePath } from '../site';

interface Props {
  title: string;
  description: string;
  section?: 'blog';
  wide?: boolean;
}

const { title, description, section, wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = `${title} — ${siteName}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#111214" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={sitePath('favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#content" class="skip">Skip to content</a>
    <header class:list={['shell', 'site-header', { 'wide-shell': wide }]}>
      <a class="brand" href={sitePath()} aria-label={`${siteName}, home`}>
        <img src={sitePath('autoinc.svg')} alt="" width="79" height="34" />
      </a>
      <nav aria-label="Main navigation">
        <a href={sitePath('#projects')}>Projects</a>
        <a href={sitePath('posts/')} aria-current={section === 'blog' ? 'page' : undefined}>Blog</a>
        <a href="https://github.com/arjunsk">GitHub</a>
      </nav>
    </header>
    <main id="content" class:list={['shell', { 'wide-shell': wide }]}>
      <slot />
    </main>
  </body>
</html>
