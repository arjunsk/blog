---
import type { CollectionEntry } from 'astro:content';
import { formatDate, sitePath } from '../site';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---
<div class="reading-list">
  {posts.map(({ id, data }) => (
    <article class="reading-row">
      <div>
        <h2><a href={sitePath(`posts/${id}/`)}>{data.title}</a></h2>
        <p>{data.summary}</p>
      </div>
      <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time>
    </article>
  ))}
</div>
