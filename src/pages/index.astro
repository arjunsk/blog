---
import Base from '../layouts/Base.astro';
import { formatDate, getVisiblePosts, projects, siteName, sitePath } from '../site';

const posts = (await getVisiblePosts()).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = posts[0];
---
<Base title="Systems notes and projects" description="Projects and interactive notes on database internals.">
  <header class="page-heading">
    <img src={sitePath('autoinc.svg')} alt="" width="76" height="56" class="monogram" />
    <h1>{siteName}</h1>
    <p>I build small systems and write about how databases work.</p>
  </header>

  <section class="content-section" id="projects" aria-labelledby="projects-title">
    <h2 id="projects-title">Projects</h2>
    <ul class="project-links">
      {projects.map(project => (
        <li><a href={project.url}>{project.name}</a></li>
      ))}
    </ul>
  </section>

  {latest && (
    <section class="content-section" aria-labelledby="latest-title">
      <h2 id="latest-title">Latest post</h2>
      <div class="reading-list">
        <article class="reading-row">
          <div>
            <h3><a href={sitePath(`posts/${latest.id}/`)}>{latest.data.title}</a></h3>
            <p>{latest.data.summary}</p>
          </div>
          <time datetime={latest.data.date.toISOString().slice(0, 10)}>{formatDate(latest.data.date)}</time>
        </article>
      </div>
    </section>
  )}
</Base>

<style>
  .monogram {
    display: block;
    margin: 0 0 .9rem -.35rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .project-links a { text-decoration-color: var(--control-border); }
  .project-links a:hover { text-decoration-color: currentColor; }
</style>
