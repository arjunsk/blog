---
import Base from '../layouts/Base.astro';
import { formatDate, formatShortDate, getVisiblePosts, sitePath } from '../site';

const recent = (await getVisiblePosts())
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
const description = 'I build small systems and write about how databases work.';
---
<Base title="Home" description={description} section="home">
  <div class="home">
    <section class="intro" aria-labelledby="intro-title">
      <div class="portrait" aria-hidden="true"><span></span></div>
      <div>
        <h1 id="intro-title">Hello, I'm Moon</h1>
        <p class="role"><strong>Database Systems Engineer</strong></p>
        <p class="description">{description}</p>
      </div>
    </section>

    {recent.length > 0 && (
      <section class="latest" aria-labelledby="latest-title">
        <header>
          <h2 id="latest-title">Latest Posts</h2>
          <a class="archive-link" href={sitePath('posts/')}>View All <span aria-hidden="true">→</span></a>
        </header>
        <ul>
          {recent.map(({ id, data }) => (
            <li>
              <a href={sitePath(`posts/${id}/`)}>
                <time datetime={data.date.toISOString().slice(0, 10)} aria-label={formatDate(data.date)}>{formatShortDate(data.date)}</time>
                <span>{data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  .home { max-width: 37rem; margin-inline: auto; }
  .intro {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 14.6rem;
    padding: 2.5rem 0 2rem;
  }

  .portrait {
    display: grid;
    place-items: center;
    flex: none;
    width: 6rem;
    aspect-ratio: 1;
    border: 3px solid transparent;
    border-radius: 50%;
    background:
      radial-gradient(circle at 29% 20%, #503346, #211f3c 72%) padding-box,
      linear-gradient(140deg, #fb995a, #a976e9) border-box;
    box-shadow: 0 .65rem 1.75rem #22244944;
  }

  .portrait span {
    width: 2.55rem;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: -.44rem .38rem 0 .04rem #ffcb9d;
    transform: translate(.15rem, -.15rem);
  }

  h1 { margin: 0 0 .375rem; font-size: 1.75rem; font-weight: 700; letter-spacing: -.026em; }
  .role { margin: 0 0 .75rem; color: var(--accent); }
  .role strong { font-weight: 550; }
  .description { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.7; }

  .latest { margin-block-start: 1.5rem; }
  .latest header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding-block-start: 1.5rem;
    margin-block-end: .9rem;
    border-block-start: 1px solid var(--control-border);
  }

  .latest h2 {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin: 0;
    font-size: 1.125rem;
  }

  .latest h2::before {
    content: '';
    width: 3px;
    height: 1.125rem;
    border-radius: 2px;
    background: linear-gradient(#f68e54, #9d6ce2);
  }

  .archive-link {
    flex: none;
    padding: .58rem 1.15rem;
    border-radius: .45rem;
    background: var(--accent-wash);
    color: var(--accent);
    font-size: .875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .archive-link:hover { background: var(--accent); color: var(--accent-ink); }
  .latest ul { margin: 0; padding: 0 0 0 .7rem; list-style: none; }
  .latest li + li { border-block-start: 1px solid var(--border); }

  .latest li a {
    display: grid;
    grid-template-columns: 4.35rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.05rem 0;
    color: inherit;
    font-size: .95rem;
    font-weight: 530;
    text-decoration: none;
  }

  .latest li a:hover { color: var(--accent); }
  time { color: var(--muted); font-size: .8rem; }

  @media (max-width: 40rem) {
    .intro { flex-direction: column; gap: .8rem; padding: 1.5rem 0 1rem; min-height: auto; text-align: center; }
    .portrait { width: 3.65rem; }
    .portrait span { width: 1.55rem; box-shadow: -.25rem .25rem 0 .02rem #ffcb9d; }
    .latest li a { gap: .65rem; }
  }
</style>
