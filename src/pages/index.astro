---
import Base from '../layouts/Base.astro';
import { formatDate, getVisiblePosts, projects, siteName, sitePath } from '../site';

const posts = (await getVisiblePosts()).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = posts[0];
---
<Base title="Systems notes and projects" description="Projects and interactive notes on database internals.">
  <header class="page-heading home-intro">
    <h1>{siteName}</h1>
    <p>Hey! I build small systems and write about how databases work.</p>
    <div class="intro-details">
      <p><strong>Currently Learning:</strong> MySQL internals, gRPC</p>
      <p><strong>Database Projects Involved:</strong> AWS Aurora, matrixone</p>
      <p class="project-links" id="projects">
        <strong>Personal Projects:</strong>
        {projects.map((project, index) => (
          <span><a href={project.url}>{project.name}</a>{index < projects.length - 1 ? ',' : ''}</span>
        ))}
      </p>
    </div>
  </header>

  {latest && (
    <section class="content-section" aria-labelledby="latest-title">
      <h2 id="latest-title">Latest post</h2>
      <div class="reading-list">
        <article class="reading-row">
          <div>
            <h3><a href={sitePath(`posts/${latest.id}/`)}>{latest.data.title}</a></h3>
            <p>{latest.data.summary}</p>
          </div>
          <time datetime={latest.data.date.toISOString().slice(0, 10)}>{formatDate(latest.data.date)}</time>
        </article>
      </div>
    </section>
  )}
</Base>

<style>
  .home-intro h1 { font-size: clamp(1.8rem, 4vw, 2.25rem); }
  .home-intro p { font-size: .9375rem; }
  .intro-details { margin-top: .65rem; }
  .intro-details p { margin: .2rem 0 0; }
  .intro-details strong { color: var(--text); font-weight: 550; }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: .1rem .35rem;
    scroll-margin-top: 1.75rem;
  }

  .project-links a { white-space: nowrap; }
  .project-links a { text-decoration-color: var(--control-border); }
  .project-links a:hover { text-decoration-color: currentColor; }
</style>
