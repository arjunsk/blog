---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getVisiblePosts, sitePath, topicAnchor } from '../../site';
import '../../styles/post-navigation.css';

interface ChapterGroup {
  topic: string;
  entries: { id: string; title: string }[];
}

export async function getStaticPaths() {
  const posts = (await getVisiblePosts()).sort((a, b) =>
    a.data.date.getTime() - b.data.date.getTime() || a.data.title.localeCompare(b.data.title),
  );
  const byTopic = new Map<string, ChapterGroup>();
  for (const { id, data: { topic, title } } of posts) {
    let group = byTopic.get(topic);
    if (!group) {
      group = { topic, entries: [] };
      byTopic.set(topic, group);
    }
    group.entries.push({ id, title });
  }
  const chapters = [...byTopic.values()].sort((a, b) => a.topic.localeCompare(b.topic));

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, chapters },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  chapters: ChapterGroup[];
}

const { post, chapters } = Astro.props;
const { Content, headings } = await render(post);
const outline = headings.filter(({ depth }) => depth <= 3);
const outlineRootDepth = outline.some(({ depth }) => depth === 1) ? 1 : 2;
const { title, summary, date, topic } = post.data;
---
<Base title={title} description={summary} section="blog" wide>
  <div class="post-layout">
    <aside class="chapter-rail" aria-label="Chapter navigation">
      <details class="rail-panel" data-post-menu open>
        <summary class="rail-title" title="Toggle chapters">
          <span class="rail-title-label">Chapters</span>
          <span class="rail-title-icon" aria-hidden="true"></span>
        </summary>
        <nav aria-label="Chapters">
          {chapters.map(chapter => (
            <details class="chapter-group" open={chapter.topic === topic}>
              <summary>{chapter.topic}</summary>
              <ul class="rail-list">
                {chapter.entries.map(entry => (
                  <li>
                    <a
                      href={sitePath(`posts/${entry.id}/`)}
                      aria-current={entry.id === post.id ? 'page' : undefined}
                    >{entry.title}</a>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </nav>
      </details>
    </aside>

    <article class:list={['post-content', { 'with-outline': outline.length > 0 }]}>
      <header class="post-header">
        <a class="back-link" href={sitePath('posts/')}>All posts</a>
        <h1>{title}</h1>
        <p class="post-meta">
          <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
          <a class="post-topic" href={sitePath(`tags/#${topicAnchor(topic)}`)}>{topic}</a>
        </p>
        <p class="post-deck">{summary}</p>
      </header>

      {outline.length > 0 && (
        <aside class="outline-rail" aria-label="Article outline">
          <details class="rail-panel" data-post-menu data-outline open>
            <summary class="rail-title" title="Toggle page outline">
              <span class="rail-title-label">On this page</span>
              <span class="rail-title-icon" aria-hidden="true"></span>
            </summary>
            <nav aria-label="On this page">
              <ul class="rail-list">
                {outline.map(({ slug, text, depth }) => (
                  <li class:list={[{ 'outline-subheading': depth > outlineRootDepth }]}>
                    <a href={`#${encodeURIComponent(slug)}`}>{text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        </aside>
      )}

      <script is:inline>
        (() => {
          const compact = window.matchMedia('(max-width: 68rem)');
          const menus = document.querySelectorAll('[data-post-menu]');
          const root = document.documentElement;
          const lastState = new WeakMap();
          const lifespan = 7 * 24 * 60 * 60 * 1000;
          const key = menu => 'autoinc:sidebar:' +
            (compact.matches ? 'mobile:' : 'desktop:') +
            (menu.hasAttribute('data-outline') ? 'outline' : 'chapters');

          function restore() {
            delete root.dataset.railMotion;
            for (const menu of menus) {
              delete menu.dataset.railReveal;
              let open = !compact.matches;
              try {
                const saved = JSON.parse(localStorage.getItem(key(menu)));
                if (typeof saved?.open === 'boolean' && saved.until > Date.now()) open = saved.open;
              } catch {
                // The sidebars still work when storage is unavailable.
              }
              lastState.set(menu, open);
              menu.open = open;
            }
          }

          restore();
          compact.addEventListener('change', restore);
          for (const menu of menus) {
            menu.querySelector('summary').addEventListener('click', () => {
              root.dataset.railMotion = '';
              menu.dataset.railReveal = '';
            });
            menu.addEventListener('toggle', () => {
              if (lastState.get(menu) === menu.open) return;
              lastState.set(menu, menu.open);
              try {
                localStorage.setItem(key(menu), JSON.stringify({ open: menu.open, until: Date.now() + lifespan }));
              } catch {
                // This page still keeps the current state.
              }
            });
          }
        })();
      </script>
      <div class="prose"><Content /></div>
    </article>
  </div>
</Base>

<script>
  const entries = [...document.querySelectorAll<HTMLAnchorElement>('[data-outline] a')].flatMap(link => {
    const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
    return heading ? [{ link, heading }] : [];
  });

  if (entries.length > 0) {
    let active: HTMLAnchorElement | undefined;
    let frame: number | undefined;

    function markActive(link: HTMLAnchorElement | undefined) {
      if (active === link) return;
      active?.removeAttribute('aria-current');
      link?.setAttribute('aria-current', 'location');
      active = link;
    }

    function markScrollPosition() {
      const entry = entries.findLast(({ heading }) => heading.getBoundingClientRect().top <= 96);
      markActive(entry?.link);
    }

    function markHash() {
      const entry = entries.find(({ link }) => link.hash === window.location.hash);
      if (entry) markActive(entry.link);
      else markScrollPosition();
    }

    window.addEventListener('scroll', () => {
      if (frame !== undefined) return;
      frame = window.requestAnimationFrame(() => {
        frame = undefined;
        markScrollPosition();
      });
    }, { passive: true });
    window.addEventListener('hashchange', markHash);
    markHash();
  }
</script>
